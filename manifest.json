{
  "manifest_version": 2,
  "name": "nest",
  "version": "3.0.0",
  "description": "A minimal custom new tab page with circular links and search",
  "content_security_policy": "script-src 'self'; object-src 'self'",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg",
    "128": "icon.svg"
  },
  "permissions": [
    "*://icons.duckduckgo.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "nest-searchtab@edgarnienhueser",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  }
}
